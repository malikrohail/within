# lending/.env — the ONLY place seeds live (gitignored). setup.py writes the four seeds itself.
BROKER_SEED=
DEPOSITOR_A_SEED=
DEPOSITOR_B_SEED=
BORROWER_SEED=
# Optional
DESK_URL=http://localhost:7500
# Desk operator auth (lending/auth.py). DESK_TOKEN gates approve/deny/manage/cover/PUT policy (header X-Desk-Token).
DESK_TOKEN=
# Set to the treasury address to require a Ledger-signed approval Payment on approve; unset = token-only approve.
# Scripted demo only: start the desk with DESK_APPROVER_ACCOUNT=off in the shell (overrides this file, approve = decidedBy human).
DESK_APPROVER_ACCOUNT=
# Optional: pin the approval signer's public key; unset = the approver account's master key.
DESK_APPROVER_PUBKEY=
