# Copy to .env.local (gitignored). Vite exposes VITE_* to the page.
VITE_DESK_URL=http://localhost:7500
# Must equal DESK_TOKEN in lending/.env: sent as X-Desk-Token on approve, deny, cover, PUT policy.
# It ships in the page bundle: it attributes operator calls on this machine, it is not a secret from local users.
VITE_DESK_TOKEN=
# The wallet (wallet/, :7402) that asks the Ledger for the approval Payment when the desk reports an approverAccount.
VITE_WALLET_URL=http://127.0.0.1:7402
