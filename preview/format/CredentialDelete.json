{
  "type": "CredentialDelete",
  "title": "Delete the \"{CredentialType|hex_text}\" credential of {Subject|account}",
  "fields": [
    {
      "path": "Account",
      "label": "Signed by",
      "format": "account"
    },
    {
      "path": "Subject",
      "label": "Subject",
      "format": "account"
    },
    {
      "path": "Issuer",
      "label": "Issuer",
      "format": "account"
    },
    {
      "path": "CredentialType",
      "label": "Credential",
      "format": "hex_text",
      "required": true
    },
    {
      "path": "Fee",
      "label": "Network fee",
      "format": "drops"
    }
  ],
  "risk": [
    {
      "when": "CredentialType",
      "level": "warn",
      "text": "Revokes the credential on-ledger at once: anything that checks it stops trusting the subject."
    }
  ]
}
