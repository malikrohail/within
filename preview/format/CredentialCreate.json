{
  "type": "CredentialCreate",
  "title": "Vouch for {Subject|account} as \"{CredentialType|hex_text}\"",
  "summary": "{Account|account} issues the \"{CredentialType|hex_text}\" credential to {Subject|account}",
  "fields": [
    {
      "path": "Account",
      "label": "Issuer",
      "format": "account"
    },
    {
      "path": "Subject",
      "label": "Subject",
      "format": "account",
      "required": true
    },
    {
      "path": "CredentialType",
      "label": "Credential",
      "format": "hex_text",
      "required": true
    },
    {
      "path": "Expiration",
      "label": "Expires",
      "format": "ripple_time"
    },
    {
      "path": "URI",
      "label": "URI",
      "format": "hex_text"
    },
    {
      "path": "Fee",
      "label": "Network fee",
      "format": "drops"
    }
  ],
  "risk": [
    {
      "when": "!Expiration",
      "level": "info",
      "text": "No expiry: the credential stays valid until it is deleted."
    }
  ]
}
