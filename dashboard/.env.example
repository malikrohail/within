# Wallet API base URL. Default http://localhost:7402. Point at the agent's stub wallet (agent/tests/stub_wallet.py) while the wallet is not up:
# VITE_WALLET_URL=http://localhost:7403
VITE_WALLET_URL=http://localhost:7402
# Operator routes (PUT /v1/policy, POST/DELETE /v1/merchants, POST /v1/domain, POST /v1/delegate) send this as
# X-Wallet-Token. Put the same value as WALLET_ADMIN_TOKEN (wallet/.env) in dashboard/.env.local, never in a tracked file.
VITE_WALLET_TOKEN=
