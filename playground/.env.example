# playground/.env (gitignored). Everything here is optional.
# Desk to talk to (public routes only). The operator token is NOT set here: server.py reads DESK_TOKEN from
# lending/.env server-side for the two operator calls (broker credential, loan default) and never sends it to the browser.
DESK_URL=http://127.0.0.1:7500
# UI -> API base (ui/.env, Vite): VITE_API_URL=http://localhost:7510
