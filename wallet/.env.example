# Created by `npm run setup` (testnet faucet) when empty.
HOT_WALLET_SEED=
PORT=7402
SPECULOS_URL=http://127.0.0.1:5000
XRPL_WSS=wss://s.altnet.rippletest.net:51233
# Operator routes (PUT /v1/policy, POST/DELETE /v1/merchants, POST /v1/domain, POST /v1/delegate) require
# header X-Wallet-Token equal to this. Empty = those routes answer 503 operator_token_unset.
# The dashboard sends VITE_WALLET_TOKEN from dashboard/.env.local. Generate one: openssl rand -hex 32
WALLET_ADMIN_TOKEN=
